(use-package fish-mode
  :ensure t
  :custom
  (fish-enable-auto-indent t)
  :mode ("\\.fish$" . fish-mode))

;; Lua Treesitter mode
(use-package lua-ts-mode
  :ensure nil
  :mode "\\.lua\\'"
  :custom
  (lua-ts-indent-offset 2)
  :config
  (treesit-ensure-grammar
   '(lua "https://github.com/MunifTanjim/tree-sitter-lua")))

;; Justfile
(use-package just-mode
  :ensure t
  :mode ("\\(?:Justfile\\|justfile\\)\\'" . just-mode))
(use-package justl
  :ensure t
  :bind ("C-c C-j" . justl))

;; Markdown mode
(use-package markdown-mode
  :ensure t
  :mode (("README\\.md\\'" . gfm-mode)
	 ("\\.page\\'"     . gfm-mode)))

;; Markdown Treesitter mode
(use-package markdown-ts-mode
  :ensure nil
  :mode ("\\.md\\'"        . markdown-ts-mode)
  :config
  (treesit-ensure-grammar
   '(markdown "https://github.com/ikatyang/tree-sitter-markdown"))
  (treesit-ensure-grammar
   '(markdown_inline "https://github.com/ikatyang/tree-sitter-markdown"
		     "split_parser"
		     "tree-sitter-markdown-inline")))

;; YAML Treesitter mode
(use-package yaml-ts-mode
  :ensure nil
  :custom
  (yaml-indent-offset 4)
  :mode ("\\.ya?ml\\'" . yaml-ts-mode)
  :config
  (treesit-ensure-grammar
   '(yaml "https://github.com/ikatyang/tree-sitter-yaml")))

;; Odin Treesitter mode
(use-package odin-ts-mode
  :vc (:url "https://github.com/Sampie159/odin-ts-mode.git"
       :main-file "odin-ts-mode.el")
  :mode "\\.odin\\'"
  :config
  (treesit-ensure-grammar
   '(odin "https://github.com/tree-sitter-grammars/tree-sitter-odin")))

