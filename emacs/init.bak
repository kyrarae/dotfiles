;;   :mode ("\\.[hc]\\(pp\\)?\\'" . simpc-mode))

;; C/C++ Treesitter mode
(use-package c-ts-mode
  :ensure nil
  :mode (("\\.[hc]\\'" . c-ts-mode)
         ("\\.cpp\\'"  . c++-ts-mode)
         ("\\.hpp\\'"  . c++-ts-mode))
  :config
  (treesit-ensure-grammar
   '(c "https://github.com/tree-sitter/tree-sitter-c"))
  (treesit-ensure-grammar
   '(cpp "https://github.com/tree-sitter/tree-sitter-cpp")))

